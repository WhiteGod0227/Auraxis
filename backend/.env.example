APP_NAME=Auraxis
AUTH_DATABASE_PATH=./auth.sqlite3
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24
DATABASE_URL=sqlite:///./auraxis.db
DATA_CACHE_DIR=./data_cache
CORS_ORIGINS=http://localhost:5180,http://localhost:5173
BHAVCOPY_URL=https://www.mcxindia.com/market-data/bhavcopy/GetDateWiseBhavCopy
BHAVCOPY_TIMEOUT=30
BHAVCOPY_RETRY_COUNT=2
BHAVCOPY_RETRY_BACKOFF=1
BHAVCOPY_REQUEST_DELAY=2
BHAVCOPY_SYMBOLS=GOLDM,GOLDTEN,GOLDGUINEA,GOLDPETAL
# Manual CSV contract sizes; no purity adjustment:
LOT_GRAMS={"GOLDM":100,"GOLDTEN":10,"GOLDGUINEA":8,"GOLDPETAL":1}
QUOTE_GRAMS={"GOLDM":10,"GOLDTEN":10,"GOLDGUINEA":8,"GOLDPETAL":1}
# Optional JSON object override for User-Agent, Accept and Referer:
# BHAVCOPY_HEADERS={"User-Agent":"Mozilla/5.0","Accept":"application/json, text/plain, */*","Referer":"https://www.mcxindia.com/market-data/bhavcopy"}
