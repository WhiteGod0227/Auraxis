APP_NAME=Auraxis
AUTH_DATABASE_PATH=./auth.sqlite3
WORKSPACE_DATABASE_PATH=./workspaces.sqlite3
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24
DATABASE_URL=sqlite:///./auraxis.db
DATA_CACHE_DIR=./data_cache
CORS_ORIGINS=http://localhost:5180,http://localhost:5173
BHAVCOPY_URL=https://www.mcxindia.com/market-data/bhavcopy/GetDateWiseBhavCopy
BHAVCOPY_TIMEOUT=30
BHAVCOPY_RETRY_COUNT=2
BHAVCOPY_RETRY_BACKOFF=1
BHAVCOPY_REQUEST_DELAY=2
BHAVCOPY_SYMBOLS=GOLDM,GOLDTEN,GOLDGUINEA,GOLDPETAL
# Manual CSV contract sizes; no purity adjustment:
LOT_GRAMS={"GOLDM":100,"GOLDTEN":10,"GOLDGUINEA":8,"GOLDPETAL":1}
QUOTE_GRAMS={"GOLDM":10,"GOLDTEN":10,"GOLDGUINEA":8,"GOLDPETAL":1}
# Optional JSON object override for User-Agent, Accept and Referer:
# BHAVCOPY_HEADERS={"User-Agent":"Mozilla/5.0","Accept":"application/json, text/plain, */*","Referer":"https://www.mcxindia.com/market-data/bhavcopy"}
# --- Live MCX data via Upstox (recommended) ---
# Upstox Developer Apps -> Analytics tab -> Generate token (free, read-only,
# valid one year). Paste it here; never commit a real token.
UPSTOX_ACCESS_TOKEN=
# Days of daily candles to fetch per refresh (active contracts only).
UPSTOX_HISTORY_DAYS=365
# Expired-contract history requires an Upstox Plus subscription.
UPSTOX_INCLUDE_EXPIRED=false
# Unit Upstox reports for MCX volume / open interest: lots or grams.
UPSTOX_VOLUME_UNIT=lots
# Automatic refresh interval while the API runs (hours, 0 disables).
AUTO_REFRESH_HOURS=6
# Comma-separated emails allowed to press "Refresh data" (empty = any signed-in user).
DATA_ADMIN_EMAILS=
# --- Auto-import MCX Bhavcopy CSVs (local use) ---
# While the API runs, any BhavCopy*.csv saved to this folder is imported,
# named by the trade date inside the file. Default folder: your Downloads.
BHAVCOPY_WATCH=false
# BHAVCOPY_WATCH_DIR=
# BHAVCOPY_WATCH_SECONDS=6
# --- Google sign-in (optional) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Add http://localhost:5180 and http://localhost:5173 as authorized JavaScript origins.
GOOGLE_CLIENT_ID=
